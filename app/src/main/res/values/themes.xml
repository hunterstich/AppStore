<resources>

    <style name="Theme.Apps.DayNight" parent="Theme.Apps" />

    <style name="Theme.Apps" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialSwitchStyle">@style/Widget.Apps.CompoundButton.MaterialSwitch</item>
        <item name="preferenceTheme">@style/AppsPreferenceThemeOverlay</item>
    </style>
    
    <style name="AppsPreferenceThemeOverlay" parent="PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.Apps</item>
    </style>
</resources>
